# Enable URL rewriting
<IfModule mod_rewrite.c>
  RewriteEngine On
</IfModule>

# Custom 404 page
ErrorDocument 404 /404.php

# Prevent directory listing
Options -Indexes

# Protect the data directory (JSON storage)
<FilesMatch "\.json$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>

# Protect config files
<FilesMatch "^(config|database)\.php$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>
